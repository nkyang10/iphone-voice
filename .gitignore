# Private key for the self-signed HTTPS certificate, and the certificate itself.
# Both are generated at runtime into data\ and must never be committed.
*.pfx
*.cer
data/

# The served page is compiled into the exe by build.ps1; web\index.html is the
# source of truth. desktop\index.html is only written for local editing.
desktop/index.html

# Local runtime output.
*.log
diagnostics.log*
dictation-bridge.log

# Local preferences: which hotkey the user chose, where they put the panel.
dictation-bridge-hotkey.txt
dictation-bridge-position.txt

# Compiled binary. The source is the artifact; build with build.ps1.
*.exe
